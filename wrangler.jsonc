{
  // Assets-only Worker: there is deliberately no "main".
  //
  // Adding a `main` later would stop _headers applying to any Worker-generated
  // response, silently dropping the security headers on those paths.
  // See https://developers.cloudflare.com/workers/static-assets/headers/
  "name": "midland-roof-shield",
  "compatibility_date": "2026-09-06",

  "assets": {
    // Build output. `node generate.js` wipes and rewrites this directory, so
    // nothing may be hand-placed inside it - _headers is emitted by the builder.
    //
    // IMPORTANT: deploy the PRODUCTION build. `STAGING_BASE=... node generate.js`
    // produces the GitHub Pages staging variant, which is prefixed and noindexed
    // and would be completely broken here. It writes to _staging, not _site,
    // precisely so the two cannot be confused.
    "directory": "./_site",

    // Serves <slug>/index.html at /<slug>/, and 307s /<slug> -> /<slug>/.
    //
    // DO NOT change to "drop-trailing-slash": every canonical, the sitemap and
    // all internal links emit the trailing-slash form, so it would create a
    // site-wide canonical mismatch.
    "html_handling": "auto-trailing-slash",

    // NOT the default, which is "none". Serves _site/404.html with a real 404
    // status for a miss at any depth.
    "not_found_handling": "404-page"
  },

  // Custom domains. Cloudflare creates and manages the DNS records for these,
  // which is why none are added by hand - hand-adding an apex A record is what
  // produces the 100117 "externally managed DNS records" conflict.
  // www is attached so it resolves, and a Redirect Rule 301s it to the apex so
  // there is only one canonical hostname.
  "routes": [
    { "pattern": "midlandroofshield.co.uk", "custom_domain": true },
    { "pattern": "www.midlandroofshield.co.uk", "custom_domain": true }
  ],

  // TRUE ONLY UNTIL THE APEX SERVES. A workers.dev URL is how the site gets
  // checked before DNS moves. Flip to false and redeploy the moment the real
  // domain is up, or a second complete copy of the site stays published on
  // workers.dev competing with the real domain in search.
  "workers_dev": true,

  // Preview URLs would republish the site on yet another hostname per version.
  "preview_urls": false
}
